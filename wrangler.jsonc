{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-growupbaby",
  "compatibility_date": "2026-09-19",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }

  // O binding da D1 fica desativado até existir uma base de dados real —
  // um database_id inválido faz falhar o deploy automático do Cloudflare.
  // Depois de correr `npx wrangler login` e `npm run db:create`, voltar a
  // adicionar aqui (substituindo pelo database_id devolvido):
  //
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "growupbaby", "database_id": "<id real>" }
  // ]
}
